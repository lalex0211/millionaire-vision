//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  GOLD CONFLUENCE 15M — Liquidités + Retests + toutes les confirmations
//  OR (XAUUSD) — 15 minutes
//
//  RÈGLE D'OR : le bot ne trade QUE dans le sens du marché.
//   • Marché HAUSSIER (bias ↑) → il ne cherche QUE des ACHATS
//   • Marché BAISSIER (bias ↓) → il ne cherche QUE des VENTES
//   • Marché neutre → il ne fait RIEN
//
//  LES 5 CONFIRMATIONS (il en faut au moins 3 en même temps) :
//   ① PRISE DE LIQUIDITÉ : le prix va chasser les stops sous un ancien
//      creux (achat) ou au-dessus d'un ancien sommet (vente) avec une
//      mèche, puis referme de l'autre côté = les institutions ont
//      ramassé la liquidité → lignes pointillées sur le graphique
//   ② RETEST : un niveau cassé franchement est revenu testé et rejeté
//   ③ ZONE INSTITUTIONNELLE : le prix rejette un Order Block ou un FVG
//   ④ BOUGIE DE REJET : pin bar / grosse mèche / englobante dans le sens
//   ⑤ VOLUME : au-dessus de la moyenne (les gros sont dans le coup)
//
//  Les confirmations restent valables quelques bougies (fenêtre de
//  confluence) : quand 3+ s'alignent avec le bias → ACHAT ou VENTE.
//
//  Gestion : SL 1,5 × ATR, TP 2R, Break-Even +1R, trailing ATR,
//  risque 1 %, max 3 trades/jour, coupe-circuit -3 %/jour.
// ═══════════════════════════════════════════════════════════════════════════

strategy("GOLD CONFLUENCE 15M — Liquidité + Retest",
     shorttitle = "GOLD-CONF",
     overlay = true,
     initial_capital = 10000,
     currency = currency.USD,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.cash_per_order,
     commission_value = 0.5,
     slippage = 2,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     max_lines_count = 500,
     max_boxes_count = 500,
     max_bars_back = 500)

// ─────────────────────────── PARAMÈTRES ────────────────────────────────────
grpLiq   = "① Liquidité & retests"
grpZone  = "② Zones OB / FVG"
grpConf  = "③ Confluence"
grpRisk  = "④ Gestion du risque"
grpGuard = "⑤ Protections"

pivLen     = input.int(5,  "Sensibilité des points de liquidité", minval = 2, maxval = 15, group = grpLiq, tooltip = "Nombre de bougies de chaque côté pour valider un sommet/creux. Plus petit = plus de niveaux.")
maxLiq     = input.int(8,  "Niveaux de liquidité gardés par côté", minval = 3, maxval = 15, group = grpLiq)
retestVal  = input.int(32, "Validité d'un niveau de retest (bougies)", minval = 8, maxval = 96, group = grpLiq)

dispMult = input.float(1.2, "Impulsion mini pour un Order Block (× ATR)", minval = 0.5, step = 0.1, group = grpZone)
fvgMin   = input.float(0.3, "Taille mini d'un FVG (× ATR)", minval = 0.1, step = 0.05, group = grpZone)
maxZones = input.int(4, "Zones actives max par type", minval = 2, maxval = 8, group = grpZone)

minConf    = input.int(3, "Confirmations minimum pour entrer (sur 5)", minval = 2, maxval = 5, group = grpConf)
confWindow = input.int(3, "Fenêtre de confluence (bougies)", minval = 1, maxval = 8, group = grpConf, tooltip = "Une prise de liquidité, un retest ou une zone touchée reste valable X bougies pour s'additionner aux autres confirmations.")
volMult    = input.float(1.3, "Volume mini (× moyenne)", minval = 1.0, step = 0.1, group = grpConf)

riskPct   = input.float(1.0, "Risque par trade (% du capital)", minval = 0.1, maxval = 3, step = 0.1, group = grpRisk)
slMult    = input.float(1.5, "Stop Loss (× ATR)", minval = 0.5, step = 0.1, group = grpRisk)
rrRatio   = input.float(2.0, "Ratio Take Profit (R:R)", minval = 1.0, step = 0.25, group = grpRisk)
trailMult = input.float(2.0, "Trailing stop (× ATR) après +1R", minval = 0.5, step = 0.1, group = grpRisk)

maxPerDay  = input.int(3,     "Max trades par jour", minval = 1, maxval = 8, group = grpGuard)
maxDayLoss = input.float(3.0, "Perte journalière max (%)", minval = 0.5, step = 0.5, group = grpGuard)
useSess    = input.bool(true, "Trader uniquement Londres + New York", group = grpGuard)
sessStr    = input.session("0700-2030", "Plage horaire (UTC)", group = grpGuard)
allowLong  = input.bool(true, "Autoriser les ACHATS", group = grpGuard)
allowShort = input.bool(true, "Autoriser les VENTES", group = grpGuard)

// ─────────────────────────── INDICATEURS ───────────────────────────────────
atrVal = ta.atr(14)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
volAvg = ta.sma(volume, 20)
[htfC, htfE] = request.security(syminfo.tickerid, "60", [close, ta.ema(close, 200)], lookahead = barmerge.lookahead_off)

// LE BIAS : décide si on cherche des achats ou des ventes
biasBull = ema50 > ema200 and close > ema200 and htfC > htfE
biasBear = ema50 < ema200 and close < ema200 and htfC < htfE

inSession = not useSess or not na(time(timeframe.period, sessStr, "UTC"))

// ─────────────────────── PROTECTIONS JOURNALIÈRES ──────────────────────────
newDay = ta.change(time("D")) != 0
var int   tradesToday    = 0
var float dayStartEquity = strategy.equity
if newDay
    tradesToday    := 0
    dayStartEquity := strategy.equity

dailyLossHit = strategy.equity <= dayStartEquity * (1 - maxDayLoss / 100)
canTrade     = tradesToday < maxPerDay and not dailyLossHit and strategy.position_size == 0

// ═══════════════ ① LIQUIDITÉ : sommets/creux = pools de stops ═══════════════
var array<line>  hiLines = array.new<line>()
var array<float> hiLvls  = array.new<float>()
var array<line>  loLines = array.new<line>()
var array<float> loLvls  = array.new<float>()

ph = ta.pivothigh(high, pivLen, pivLen)
plv = ta.pivotlow(low, pivLen, pivLen)

if not na(ph)
    l = line.new(bar_index - pivLen, ph, bar_index, ph, extend = extend.right, color = color.new(color.red, 35), style = line.style_dotted, width = 1)
    array.push(hiLines, l)
    array.push(hiLvls, ph)
    if array.size(hiLines) > maxLiq
        line.delete(array.shift(hiLines))
        array.shift(hiLvls)

if not na(plv)
    l = line.new(bar_index - pivLen, plv, bar_index, plv, extend = extend.right, color = color.new(color.green, 35), style = line.style_dotted, width = 1)
    array.push(loLines, l)
    array.push(loLvls, plv)
    if array.size(loLines) > maxLiq
        line.delete(array.shift(loLines))
        array.shift(loLvls)

// Mémoire des événements (bar_index du dernier événement de chaque type)
var int   grabLbar   = na   // prise de liquidité BASSE  → confirmation ACHAT
var int   grabSbar   = na   // prise de liquidité HAUTE  → confirmation VENTE
var float retestLvlL = na   // niveau cassé à la hausse, à retester (ACHAT)
var int   retestLset = na
var float retestLvlS = na   // niveau cassé à la baisse, à retester (VENTE)
var int   retestSset = na
var int   retestLbar = na   // retest ACHAT validé
var int   retestSbar = na   // retest VENTE validé

// Balayage des SOMMETS : mèche au-dessus + rejet = prise de liquidité (VENTE)
//                        clôture au-dessus = cassure → futur retest (ACHAT)
if array.size(hiLvls) > 0
    for i = array.size(hiLvls) - 1 to 0
        lvl = array.get(hiLvls, i)
        if high > lvl
            ln = array.get(hiLines, i)
            line.set_extend(ln, extend.none)
            line.set_x2(ln, bar_index)
            if close < lvl
                grabSbar := bar_index
                line.set_color(ln, color.new(color.fuchsia, 0))
                line.set_width(ln, 2)
            else
                retestLvlL := lvl
                retestLset := bar_index
                line.set_color(ln, color.new(color.gray, 60))
            array.remove(hiLines, i)
            array.remove(hiLvls, i)

// Balayage des CREUX : mèche en dessous + rejet = prise de liquidité (ACHAT)
if array.size(loLvls) > 0
    for i = array.size(loLvls) - 1 to 0
        lvl = array.get(loLvls, i)
        if low < lvl
            ln = array.get(loLines, i)
            line.set_extend(ln, extend.none)
            line.set_x2(ln, bar_index)
            if close > lvl
                grabLbar := bar_index
                line.set_color(ln, color.new(color.fuchsia, 0))
                line.set_width(ln, 2)
            else
                retestLvlS := lvl
                retestSset := bar_index
                line.set_color(ln, color.new(color.gray, 60))
            array.remove(loLines, i)
            array.remove(loLvls, i)

// ═══════════════ ② RETESTS des niveaux cassés ═══════════════════════════════
// Expiration / invalidation des niveaux de retest
if not na(retestLvlL) and (bar_index - retestLset > retestVal or close < retestLvlL - atrVal)
    retestLvlL := na
if not na(retestLvlS) and (bar_index - retestSset > retestVal or close > retestLvlS + atrVal)
    retestLvlS := na

// Retest validé : le prix revient toucher le niveau et le rejette
if not na(retestLvlL) and low <= retestLvlL and close > retestLvlL
    retestLbar := bar_index
    retestLvlL := na
if not na(retestLvlS) and high >= retestLvlS and close < retestLvlS
    retestSbar := bar_index
    retestLvlS := na

plot(retestLvlL, "Niveau de retest ACHAT", color = color.new(color.green, 30), style = plot.style_linebr, linewidth = 2)
plot(retestLvlS, "Niveau de retest VENTE", color = color.new(color.red, 30),   style = plot.style_linebr, linewidth = 2)

// ═══════════════ ③ ZONES : Order Blocks + FVG ═══════════════════════════════
var array<box> bullZones = array.new<box>()
var array<box> bearZones = array.new<box>()
var int zoneLbar = na
var int zoneSbar = na

addZone(array<box> arr, int leftBar, float top, float bottom, color bg, color bord, string txt) =>
    b = box.new(leftBar, top, bar_index, bottom, border_color = bord, bgcolor = bg, extend = extend.right, text = txt, text_color = bord, text_size = size.tiny, text_halign = text.align_left)
    array.push(arr, b)
    if array.size(arr) > maxZones
        box.delete(array.shift(arr))

// D'abord les touches sur zones existantes (jamais sur la bougie de création)
if array.size(bullZones) > 0
    for i = array.size(bullZones) - 1 to 0
        b   = array.get(bullZones, i)
        t   = box.get_top(b)
        btm = box.get_bottom(b)
        if close < btm
            box.set_extend(b, extend.none)
            box.set_right(b, bar_index)
            box.set_bgcolor(b, color.new(color.gray, 92))
            array.remove(bullZones, i)
        else if low <= t and close > t and close > open
            zoneLbar := bar_index
            box.set_extend(b, extend.none)
            box.set_right(b, bar_index)
            array.remove(bullZones, i)

if array.size(bearZones) > 0
    for i = array.size(bearZones) - 1 to 0
        b   = array.get(bearZones, i)
        t   = box.get_top(b)
        btm = box.get_bottom(b)
        if close > t
            box.set_extend(b, extend.none)
            box.set_right(b, bar_index)
            box.set_bgcolor(b, color.new(color.gray, 92))
            array.remove(bearZones, i)
        else if high >= btm and close < btm and close < open
            zoneSbar := bar_index
            box.set_extend(b, extend.none)
            box.set_right(b, bar_index)
            array.remove(bearZones, i)

// Puis création des nouvelles zones
bullImpulse = close > open and (close - open) >= dispMult * atrVal and close > high[1]
bearImpulse = close < open and (open - close) >= dispMult * atrVal and close < low[1]

if bullImpulse and close[1] < open[1]
    addZone(bullZones, bar_index - 1, high[1], low[1], color.new(color.green, 85), color.new(color.green, 40), "OB ↑")
if bearImpulse and close[1] > open[1]
    addZone(bearZones, bar_index - 1, high[1], low[1], color.new(color.red, 85), color.new(color.red, 40), "OB ↓")
if low > high[2] and (low - high[2]) >= fvgMin * atrVal
    addZone(bullZones, bar_index - 2, low, high[2], color.new(color.teal, 88), color.new(color.teal, 45), "FVG ↑")
if high < low[2] and (low[2] - high) >= fvgMin * atrVal
    addZone(bearZones, bar_index - 2, low[2], high, color.new(color.orange, 88), color.new(color.orange, 45), "FVG ↓")

// ═══════════════ ④ BOUGIE DE REJET + ⑤ VOLUME ══════════════════════════════
rng = math.max(high - low, syminfo.mintick)
bullReject = close > open and ((math.min(open, close) - low) >= 0.5 * rng or close > high[1])
bearReject = close < open and ((high - math.max(open, close)) >= 0.5 * rng or close < low[1])
volOK = volume >= volAvg * volMult

// ═══════════════ CONFLUENCE : le comptage final ═════════════════════════════
recent(int b) =>
    not na(b) and bar_index - b <= confWindow

confGrabL   = recent(grabLbar)
confGrabS   = recent(grabSbar)
confRetestL = recent(retestLbar)
confRetestS = recent(retestSbar)
confZoneL   = recent(zoneLbar)
confZoneS   = recent(zoneSbar)

scoreL = (confGrabL ? 1 : 0) + (confRetestL ? 1 : 0) + (confZoneL ? 1 : 0) + (bullReject ? 1 : 0) + (volOK ? 1 : 0)
scoreS = (confGrabS ? 1 : 0) + (confRetestS ? 1 : 0) + (confZoneS ? 1 : 0) + (bearReject ? 1 : 0) + (volOK ? 1 : 0)

longSig  = allowLong  and canTrade and inSession and biasBull and close > open and scoreL >= minConf
shortSig = allowShort and canTrade and inSession and biasBear and close < open and scoreS >= minConf

// ─────────────────────── GESTION DE POSITION ────────────────────────────────
var float stopPrice = na
var float tpPrice   = na
var float riskDist  = na

calcQty(slDistance) =>
    math.max((strategy.equity * riskPct / 100) / slDistance, 0.01)

if longSig
    riskDist  := atrVal * slMult
    stopPrice := close - riskDist
    tpPrice   := close + riskDist * rrRatio
    q = calcQty(riskDist)
    strategy.entry("ACHAT", strategy.long, qty = q, alert_message = '{"bot":"GOLD_CONF","action":"buy","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close, format.mintick) + ',"sl":' + str.tostring(stopPrice, format.mintick) + ',"tp":' + str.tostring(tpPrice, format.mintick) + ',"score":"' + str.tostring(scoreL) + '/5"}')
    tradesToday += 1
    grabLbar := na
    retestLbar := na
    zoneLbar := na

if shortSig
    riskDist  := atrVal * slMult
    stopPrice := close + riskDist
    tpPrice   := close - riskDist * rrRatio
    q = calcQty(riskDist)
    strategy.entry("VENTE", strategy.short, qty = q, alert_message = '{"bot":"GOLD_CONF","action":"sell","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close, format.mintick) + ',"sl":' + str.tostring(stopPrice, format.mintick) + ',"tp":' + str.tostring(tpPrice, format.mintick) + ',"score":"' + str.tostring(scoreS) + '/5"}')
    tradesToday += 1
    grabSbar := na
    retestSbar := na
    zoneSbar := na

// Break-Even à +1R puis trailing ATR
if strategy.position_size > 0
    entryP = strategy.position_avg_price
    if high >= entryP + riskDist
        stopPrice := math.max(stopPrice, entryP + syminfo.mintick * 10)
        stopPrice := math.max(stopPrice, close - atrVal * trailMult)

if strategy.position_size < 0
    entryP = strategy.position_avg_price
    if low <= entryP - riskDist
        stopPrice := math.min(stopPrice, entryP - syminfo.mintick * 10)
        stopPrice := math.min(stopPrice, close + atrVal * trailMult)

if strategy.position_size > 0
    strategy.exit("SORTIE-A", from_entry = "ACHAT", stop = stopPrice, limit = tpPrice, alert_message = '{"bot":"GOLD_CONF","action":"close_buy","symbol":"' + syminfo.ticker + '"}')
if strategy.position_size < 0
    strategy.exit("SORTIE-V", from_entry = "VENTE", stop = stopPrice, limit = tpPrice, alert_message = '{"bot":"GOLD_CONF","action":"close_sell","symbol":"' + syminfo.ticker + '"}')

// ─────────────────────────── AFFICHAGE ─────────────────────────────────────
plot(ema200, "EMA 200", color = biasBull ? color.new(color.green, 30) : biasBear ? color.new(color.red, 30) : color.new(color.gray, 50), linewidth = 2)

plotshape(longSig,  "ACHAT confluence", shape.triangleup,   location.belowbar, color.new(color.green, 0), size = size.normal, text = "ACHAT")
plotshape(shortSig, "VENTE confluence", shape.triangledown, location.abovebar, color.new(color.red, 0),   size = size.normal, text = "VENTE")
plotshape(confGrabL and not confGrabL[1], "Liquidité prise (bas)",  shape.diamond, location.belowbar, color.new(color.fuchsia, 0), size = size.tiny, text = "LIQ")
plotshape(confGrabS and not confGrabS[1], "Liquidité prise (haut)", shape.diamond, location.abovebar, color.new(color.fuchsia, 0), size = size.tiny, text = "LIQ")

plot(strategy.position_size != 0 ? stopPrice : na, "Stop Loss",   color = color.new(color.red, 0),   style = plot.style_linebr, linewidth = 2)
plot(strategy.position_size != 0 ? tpPrice   : na, "Take Profit", color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 2)

bgcolor(dailyLossHit ? color.new(color.red, 88) : na, title = "Coupe-circuit journalier")

// ─────────────────── CHECKLIST EN DIRECT (tableau) ──────────────────────────
var table dash = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 60))
ck(bool v) => v ? "✔" : "✘"
ckCol(bool v) => v ? color.green : color.new(color.gray, 40)
if barstate.islast
    biasTxt = biasBull ? "HAUSSIER → ACHATS" : biasBear ? "BAISSIER → VENTES" : "NEUTRE — on ne trade pas"
    biasCol = biasBull ? color.green : biasBear ? color.red : color.gray
    score   = biasBull ? scoreL : biasBear ? scoreS : 0
    g  = biasBear ? confGrabS   : confGrabL
    r  = biasBear ? confRetestS : confRetestL
    z  = biasBear ? confZoneS   : confZoneL
    rj = biasBear ? bearReject  : bullReject
    table.cell(dash, 0, 0, "GOLD CONFLUENCE", text_color = color.yellow, text_size = size.small)
    table.cell(dash, 1, 0, biasTxt, text_color = biasCol, text_size = size.small)
    table.cell(dash, 0, 1, "① Prise de liquidité", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 1, ck(g), text_color = ckCol(g), text_size = size.small)
    table.cell(dash, 0, 2, "② Retest validé", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 2, ck(r), text_color = ckCol(r), text_size = size.small)
    table.cell(dash, 0, 3, "③ Zone OB/FVG rejetée", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 3, ck(z), text_color = ckCol(z), text_size = size.small)
    table.cell(dash, 0, 4, "④ Bougie de rejet", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 4, ck(rj), text_color = ckCol(rj), text_size = size.small)
    table.cell(dash, 0, 5, "⑤ Volume fort", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 5, ck(volOK), text_color = ckCol(volOK), text_size = size.small)
    table.cell(dash, 0, 6, "SCORE", text_color = color.yellow, text_size = size.tiny)
    table.cell(dash, 1, 6, str.tostring(score) + " / 5  (mini " + str.tostring(minConf) + ")", text_color = score >= minConf ? color.green : color.white, text_size = size.small)
    winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0.0
    pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : 0.0
    table.cell(dash, 0, 7, "Réussite / PF", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 7, str.tostring(winRate, "#.#") + " % / " + str.tostring(pf, "#.##"), text_color = pf >= 1.3 ? color.green : color.orange, text_size = size.tiny)
    table.cell(dash, 0, 8, "Trades aujourd'hui", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 8, str.tostring(tradesToday) + " / " + str.tostring(maxPerDay), text_color = tradesToday >= maxPerDay ? color.red : color.white, text_size = size.tiny)
